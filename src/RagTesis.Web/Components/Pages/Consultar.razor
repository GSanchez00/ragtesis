@page "/consultar"
@using RagTesis.Embeddings
@inject IConfiguration Configuracion

<PageTitle>Consultar</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Consultar</h1>
        <p>Preguntale en lenguaje natural a un documento ya guardado en Qdrant.</p>
    </div>

    <div class="card stack">
        <div>
            <span class="field-label">Colección</span>
            <div class="segmented">
                <label class="@ClaseSegmento("tesis")">
                    <input type="radio" name="coleccion" checked="@(Coleccion == "tesis")"
                           @onchange="@(() => Coleccion = "tesis")" disabled="@_consultando" />
                    Mi tesis
                </label>
                <label class="@ClaseSegmento("corpus")">
                    <input type="radio" name="coleccion" checked="@(Coleccion == "corpus")"
                           @onchange="@(() => Coleccion = "corpus")" disabled="@_consultando" />
                    Corpus de libros
                </label>
            </div>
        </div>

        <div>
            <span class="field-label">Proveedor</span>
            <div class="segmented">
                <label class="@ClaseSegmentoBase("gemini")">
                    <input type="radio" name="proveedor-base" checked="@(ProveedorBase == "gemini")"
                           @onchange="@(() => ProveedorBase = "gemini")" disabled="@_consultando" />
                    Gemini
                </label>
                <label class="@ClaseSegmentoBase("nvidia")">
                    <input type="radio" name="proveedor-base" checked="@(ProveedorBase == "nvidia")"
                           @onchange="@(() => ProveedorBase = "nvidia")" disabled="@_consultando" />
                    NVIDIA
                </label>
            </div>

            @if (ProveedorBase == "gemini")
            {
                <div class="segmented" style="margin-top: 0.5rem;">
                    <label class="@ClaseSegmentoModelo(ProveedorLlm.Gemini)">
                        <input type="radio" name="modelo-gemini" checked="@(ModeloGemini == ProveedorLlm.Gemini)"
                               @onchange="@(() => ModeloGemini = ProveedorLlm.Gemini)" disabled="@_consultando" />
                        3.6 Flash
                    </label>
                    <label class="@ClaseSegmentoModelo(ProveedorLlm.GeminiFlashLite)">
                        <input type="radio" name="modelo-gemini" checked="@(ModeloGemini == ProveedorLlm.GeminiFlashLite)"
                               @onchange="@(() => ModeloGemini = ProveedorLlm.GeminiFlashLite)" disabled="@_consultando" />
                        3.5 Flash Lite
                    </label>
                    <label class="@ClaseSegmentoModelo(ProveedorLlm.Gemini37Flash)">
                        <input type="radio" name="modelo-gemini" checked="@(ModeloGemini == ProveedorLlm.Gemini37Flash)"
                               @onchange="@(() => ModeloGemini = ProveedorLlm.Gemini37Flash)" disabled="@_consultando" />
                        3.7 Flash
                    </label>
                    <label class="@ClaseSegmentoModelo(ProveedorLlm.Gemini38Flash)">
                        <input type="radio" name="modelo-gemini" checked="@(ModeloGemini == ProveedorLlm.Gemini38Flash)"
                               @onchange="@(() => ModeloGemini = ProveedorLlm.Gemini38Flash)" disabled="@_consultando" />
                        3.8 Flash
                    </label>
                </div>
            }

            <p class="field-hint">
                Modelo: <span class="badge">@ChatClientFactory.ModeloDe(Proveedor)</span>
                — el embedding de la pregunta siempre usa Gemini.
            </p>
        </div>

        <div>
            <label class="field-label" for="pregunta">Pregunta</label>
            <textarea id="pregunta" class="text-input" placeholder="ej. ¿Por qué Pedro dudaba en comer con gentiles?"
                      @bind="Pregunta" disabled="@_consultando"></textarea>
        </div>

        <div>
            <button class="btn btn-primary" @onclick="ConsultarAsync" disabled="@(_consultando || string.IsNullOrWhiteSpace(Pregunta))">
                @if (_consultando)
                {
                    <span class="spinner"></span>
                    <span>Consultando...</span>
                }
                else
                {
                    <span>Preguntar</span>
                }
            </button>
            @if (_consultando && !string.IsNullOrEmpty(_fase))
            {
                <p class="field-hint">@_fase</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(_mensaje))
        {
            <div class="alert @(_error ? "alert-error" : "alert-info")">@_mensaje</div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_respuesta))
    {
        <div class="card">
            <span class="field-label">Respuesta</span>
            <div class="respuesta">@_respuesta</div>
        </div>
    }

    @if (_fragmentos.Count > 0)
    {
        <div class="card">
            <details class="fragmentos" open>
                <summary>@_fragmentos.Count fragmentos recuperados</summary>
                @foreach (var (chunk, score) in _fragmentos)
                {
                    <div class="fragmento">
                        <div class="fragmento-header">
                            <span class="fragmento-seccion">@chunk.Seccion</span>
                            <span class="badge">score @score.ToString("F4")</span>
                        </div>
                        <div class="fragmento-texto">@Truncar(chunk.Texto, 240)</div>
                    </div>
                }
            </details>
        </div>
    }
</div>

@code {
    private string Coleccion { get; set; } = "tesis";
    private string Pregunta { get; set; } = "";
    private string ProveedorBase { get; set; } = "gemini";
    private ProveedorLlm ModeloGemini { get; set; } = ProveedorLlm.Gemini;
    private ProveedorLlm Proveedor => ProveedorBase == "nvidia" ? ProveedorLlm.Nvidia : ModeloGemini;

    private bool _consultando;
    private bool _error;
    private string? _mensaje;
    private string? _respuesta;
    private string? _fase;
    private List<(ChunkVectorRecord Chunk, double Score)> _fragmentos = new();

    private string ClaseSegmento(string valor)
    {
        var clases = valor == Coleccion ? "selected" : "";
        if (_consultando) clases += " disabled";
        return clases;
    }

    private string ClaseSegmentoBase(string valor)
    {
        var clases = valor == ProveedorBase ? "selected" : "";
        if (_consultando) clases += " disabled";
        return clases;
    }

    private string ClaseSegmentoModelo(ProveedorLlm valor)
    {
        var clases = valor == ModeloGemini ? "selected" : "";
        if (_consultando) clases += " disabled";
        return clases;
    }

    private static string Truncar(string texto, int maxCaracteres) =>
        texto.Length <= maxCaracteres ? texto : texto[..maxCaracteres] + "...";

    private async Task ConsultarAsync()
    {
        if (string.IsNullOrWhiteSpace(Pregunta))
            return;

        _consultando = true;
        _mensaje = null;
        _respuesta = null;
        _fragmentos = new();
        _fase = "Generando embedding de la pregunta...";
        StateHasChanged();

        try
        {
            var nombreColeccion = Coleccion == "tesis" ? "mi-tesis" : "corpus-libros";
            Console.WriteLine($"[Consultar] Inicio. Colección: {nombreColeccion}. Pregunta: \"{Pregunta}\"");

            var apiKey = Configuracion["GoogleApiKey"]
                ?? throw new InvalidOperationException("Falta configurar GoogleApiKey con dotnet user-secrets.");

            var embeddingService = new EmbeddingService(apiKey);
            var vectorStoreSetup = new VectorStoreSetup(nombreColeccion);
            await vectorStoreSetup.InicializarAsync();

            var vectorPregunta = await embeddingService.GenerarEmbeddingAsync(Pregunta);
            Console.WriteLine("[Consultar] Embedding de la pregunta generado.");

            _fase = "Buscando fragmentos relevantes en Qdrant...";
            StateHasChanged();

            _fragmentos = await vectorStoreSetup.BuscarAsync(vectorPregunta, top: 5);
            Console.WriteLine($"[Consultar] {_fragmentos.Count} fragmentos recuperados de Qdrant.");

            if (_fragmentos.Count == 0)
            {
                _mensaje = $"No hay chunks guardados en \"{nombreColeccion}\" todavía.";
                _error = true;
                return;
            }

            _fase = $"Generando respuesta con {ChatClientFactory.ModeloDe(Proveedor)}...";
            StateHasChanged();

            var apiKeyProveedor = Proveedor == ProveedorLlm.Nvidia
                ? Configuracion["NvidiaApiKey"] ?? throw new InvalidOperationException("Falta configurar NvidiaApiKey con dotnet user-secrets.")
                : apiKey;

            var chatClient = ChatClientFactory.Crear(Proveedor, apiKeyProveedor);
            var consultaService = new ConsultaTesisService(chatClient);

            var timeoutSegundos = Proveedor == ProveedorLlm.Nvidia ? 180 : 90;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSegundos));
            _respuesta = await consultaService.ResponderPreguntaAsync(Pregunta, _fragmentos, cts.Token);
            Console.WriteLine("[Consultar] Respuesta del LLM recibida.");
        }
        catch (OperationCanceledException)
        {
            var modelo = ChatClientFactory.ModeloDe(Proveedor);
            Console.WriteLine($"[Consultar] Timeout: {modelo} no respondió a tiempo.");
            _mensaje = $"{modelo} no respondió a tiempo. Podría ser un límite de cuota o un problema de red. Probá de nuevo en un momento.";
            _error = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Consultar] Error: {ex}");
            _mensaje = $"Error: {ex.Message}";
            _error = true;
        }
        finally
        {
            _consultando = false;
            _fase = null;
        }
    }
}
