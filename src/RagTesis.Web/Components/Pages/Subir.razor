@page "/subir"
@using RagTesis.Embeddings
@inject IConfiguration Configuracion

<PageTitle>Subir documento</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Subir documento</h1>
        <p>Troceá, generá embeddings y guardá un documento en Qdrant.</p>
    </div>

    <div class="card stack">
        <div>
            <span class="field-label">Tipo de documento</span>
            <div class="segmented">
                <label class="@ClaseSegmento("tesis")">
                    <input type="radio" name="tipo" checked="@(TipoDocumento == "tesis")"
                           @onchange="@(() => TipoDocumento = "tesis")" disabled="@_procesando" />
                    Mi tesis
                </label>
                <label class="@ClaseSegmento("corpus")">
                    <input type="radio" name="tipo" checked="@(TipoDocumento == "corpus")"
                           @onchange="@(() => TipoDocumento = "corpus")" disabled="@_procesando" />
                    Libro del corpus
                </label>
            </div>
            <p class="field-hint">
                Se guarda en la colección
                <span class="badge">@(TipoDocumento == "tesis" ? "mi-tesis" : "corpus-libros")</span>
            </p>
        </div>

        @if (TipoDocumento == "corpus")
        {
            <div>
                <label class="field-label" for="nombreLibro">Nombre del libro</label>
                <input id="nombreLibro" class="text-input" placeholder="ej. Dunn - Beginning from Jerusalem"
                       @bind="NombreLibro" disabled="@_procesando" />
            </div>
        }

        <div>
            <span class="field-label">Archivo (.md)</span>
            <div class="file-drop">
                <InputFile OnChange="OnArchivoSeleccionadoAsync" accept=".md" disabled="@_procesando" />
                @if (!string.IsNullOrEmpty(_nombreArchivo))
                {
                    <p class="field-hint">
                        @($"{_nombreArchivo}.md") · @_contenidoMarkdown?.Length caracteres
                    </p>
                }
            </div>
        </div>

        <div>
            <button class="btn btn-primary" @onclick="ProcesarAsync" disabled="@(_procesando || _contenidoMarkdown is null)">
                @if (_procesando)
                {
                    <span class="spinner"></span>
                    <span>Procesando (puede tardar varios minutos)...</span>
                }
                else
                {
                    <span>Procesar y guardar</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_mensaje))
        {
            <div class="alert @(_error ? "alert-error" : "alert-success")">@_mensaje</div>
        }
    </div>
</div>

@code {
    private string TipoDocumento { get; set; } = "tesis";
    private string NombreLibro { get; set; } = "";

    private string? _contenidoMarkdown;
    private string? _nombreArchivo;
    private bool _procesando;
    private bool _error;
    private string? _mensaje;

    private string ClaseSegmento(string valor)
    {
        var clases = valor == TipoDocumento ? "selected" : "";
        if (_procesando) clases += " disabled";
        return clases;
    }

    private async Task OnArchivoSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;

        if (!archivo.Name.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            _mensaje = "Solo se aceptan archivos .md.";
            _error = true;
            _contenidoMarkdown = null;
            _nombreArchivo = null;
            return;
        }

        using var stream = archivo.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var lector = new StreamReader(stream);
        _contenidoMarkdown = await lector.ReadToEndAsync();
        _nombreArchivo = Path.GetFileNameWithoutExtension(archivo.Name);
        _mensaje = null;
    }

    private async Task ProcesarAsync()
    {
        if (_contenidoMarkdown is null || _nombreArchivo is null)
            return;

        if (TipoDocumento == "corpus" && string.IsNullOrWhiteSpace(NombreLibro))
        {
            _mensaje = "Falta el nombre del libro.";
            _error = true;
            return;
        }

        _procesando = true;
        _mensaje = null;
        StateHasChanged();

        try
        {
            var nombreColeccion = TipoDocumento == "tesis" ? "mi-tesis" : "corpus-libros";
            var nombreDocumento = TipoDocumento == "tesis" ? _nombreArchivo : NombreLibro;

            var chunks = await MarkdownChunker.ChunkearMarkdownDesdeTextoAsync(_contenidoMarkdown, nombreDocumento);
            chunks = chunks.Where(c => !string.IsNullOrWhiteSpace(c.Seccion)).ToList();

            var apiKey = Configuracion["GoogleApiKey"]
                ?? throw new InvalidOperationException("Falta configurar GoogleApiKey con dotnet user-secrets.");

            var embeddingService = new EmbeddingService(apiKey);
            var vectorStoreSetup = new VectorStoreSetup(nombreColeccion);
            await vectorStoreSetup.InicializarAsync();

            var chunksConEmbeddings = await embeddingService.GenerarEmbeddingsAsync(chunks);
            await vectorStoreSetup.GuardarChunksAsync(chunksConEmbeddings);

            _mensaje = $"Listo: {chunksConEmbeddings.Count} chunks guardados en \"{nombreColeccion}\".";
            _error = false;
        }
        catch (Exception ex)
        {
            _mensaje = $"Error: {ex.Message}";
            _error = true;
        }
        finally
        {
            _procesando = false;
        }
    }
}
