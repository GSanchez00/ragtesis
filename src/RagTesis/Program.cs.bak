var chunks = MarkdownChunker.ChunkearPorSecciones(
    "../../output/markdown/Cap_26_Dunn.md",
    "Dunn - Beginning from Jerusalem, Cap. 26"
);

Console.WriteLine($"Total de chunks generados: {chunks.Count}");
foreach (var c in chunks.Take(3))
{
    Console.WriteLine($"\n--- Sección: {c.Seccion} (chunk #{c.NumeroChunk}) ---");
    Console.WriteLine(c.Texto.Substring(0, Math.Min(150, c.Texto.Length)) + "...");
}