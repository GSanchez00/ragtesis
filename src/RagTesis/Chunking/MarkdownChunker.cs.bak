using System.Text.RegularExpressions;
using Microsoft.SemanticKernel.Text;

public class MarkdownChunker
{
    public static List<ChunkMetadata> ChunkearPorSecciones(string rutaArchivoMd, string nombreLibro)
    {
        var texto = File.ReadAllText(rutaArchivoMd);
        var chunks = new List<ChunkMetadata>();

        // Divide el documento en bloques usando los encabezados ## y ### como puntos de corte
        var patron = new Regex(@"^(#{2,3})\s+(.+)$", RegexOptions.Multiline);
        var matches = patron.Matches(texto);

        for (int i = 0; i < matches.Count; i++)
        {
            var inicioContenido = matches[i].Index + matches[i].Length;
            var finContenido = (i + 1 < matches.Count) ? matches[i + 1].Index : texto.Length;

            var tituloSeccion = matches[i].Groups[2].Value.Trim();
            var contenidoSeccion = texto.Substring(inicioContenido, finContenido - inicioContenido).Trim();

            if (string.IsNullOrWhiteSpace(contenidoSeccion))
                continue;

            // Subdivide la sección usando TextChunker de Semantic Kernel, contando por tokens
            var lineasSeccion = contenidoSeccion.Split('\n');
            var subChunks = TextChunker.SplitMarkdownParagraphs(
                lineasSeccion,
                maxTokensPerParagraph: 300,
                overlapTokens: 50,
                chunkHeader: $"[{nombreLibro} - {tituloSeccion}]\n" // se prepende a cada chunk, útil de contexto
            );

            foreach (var subChunk in subChunks)
            {
                chunks.Add(new ChunkMetadata
                {
                    Libro = nombreLibro,
                    Seccion = tituloSeccion,
                    NumeroChunk = chunks.Count,
                    Texto = subChunk
                });
            }
        }

        return chunks;
    }
}